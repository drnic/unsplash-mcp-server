{
  "name": "unsplash-mcp-server",
  "version": "1.0.0",
  "description": "Unsplash MCP server (Streamable HTTP + stdio) with proper photo attribution. Pass-through: callers supply their own Unsplash access key.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/http.ts",
    "dev": "bun --watch src/http.ts",
    "stdio": "bun src/stdio.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
